create table "catalog"."test17949296328766164222_test_dimension_backfill"."product_dim" as (with observations as (
    select "region", "sku", "effective_at", "price"
    from "catalog"."test17949296328766164222_test_dimension_backfill"."product_dim__dbt_observations"
  ),
  change_points as (
    select
      "region", "sku",
      "price",
      "effective_at" as "valid_from",
      row("price") is distinct from
        lag(row("price")) over (
          partition by "region", "sku" order by "effective_at"
        ) as dbt_is_change_point
    from observations
  ),
  versions as (
    select
      "region", "sku",
      "price",
      "valid_from",
      lead("valid_from") over (
        partition by "region", "sku" order by "valid_from"
      ) as "valid_to"
    from change_points
    where dbt_is_change_point
  )
  select
    dbt_current."region", dbt_current."sku",
    dbt_current."price",
    dbt_current."valid_from",
    dbt_current."valid_to",
    md5(concat_ws(chr(31), coalesce(cast(dbt_current."region" as varchar), chr(30)), coalesce(cast(dbt_current."sku" as varchar), chr(30)), cast(dbt_current."valid_from" as varchar))) as "dimension_version_id"
  from versions as dbt_current)

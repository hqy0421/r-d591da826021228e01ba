create table "tmp"."test17949296420084746443_test_dimension_backfill"."customer_dim__dbt_tmp" as (with observations as (
    select "customer_id", "effective_at", "name", "segment"
    from "tmp"."test17949296420084746443_test_dimension_backfill"."customer_dim__dbt_observations"
  ),
  change_points as (
    select
      "customer_id",
      "name", "segment",
      "effective_at" as "valid_from",
      row("name", "segment") is distinct from
        lag(row("name", "segment")) over (
          partition by "customer_id" order by "effective_at"
        ) as dbt_is_change_point
    from observations
  ),
  versions as (
    select
      "customer_id",
      "name", "segment",
      "valid_from",
      lead("valid_from") over (
        partition by "customer_id" order by "valid_from"
      ) as "valid_to"
    from change_points
    where dbt_is_change_point
  )
  select
    dbt_current."customer_id",
    dbt_current."name", dbt_current."segment",
    dbt_current."valid_from",
    dbt_current."valid_to",
    coalesce(prior."dimension_version_id", md5(concat_ws(chr(31), coalesce(cast(dbt_current."customer_id" as varchar), chr(30)), cast(dbt_current."valid_from" as varchar)))) as "dimension_version_id"
  from versions as dbt_current
  left join "tmp"."test17949296420084746443_test_dimension_backfill"."customer_dim" as prior
    on prior."valid_from" is not distinct from dbt_current."valid_from"
    and prior."customer_id" is not distinct from dbt_current."customer_id")
